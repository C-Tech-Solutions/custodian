<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Surface" Color="#0F1115"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#181B22"/>
    <SolidColorBrush x:Key="SurfaceSubtle" Color="#1F232B"/>
    <SolidColorBrush x:Key="SurfaceMuted" Color="#262A33"/>
    <SolidColorBrush x:Key="HeaderSurface" Color="#13161C"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#181B22"/>
    <SolidColorBrush x:Key="OverlayScrim" Color="#A0000000"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="Border" Color="#262A33"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#363B47"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#262A33"/>
    <SolidColorBrush x:Key="Divider" Color="#1F232B"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#22262E"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#E6E9EF"/>
    <SolidColorBrush x:Key="TextStrong" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="MutedStrong" Color="#B6BECC"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5C6473"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#60A5FA"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentSubtle" Color="#1E2A44"/>
    <SolidColorBrush x:Key="AccentRing" Color="#1D4ED8"/>

    <!-- States -->
    <SolidColorBrush x:Key="HoverFill" Color="#22262E"/>
    <SolidColorBrush x:Key="PressedFill" Color="#2A2F38"/>
    <SolidColorBrush x:Key="SelectionFill" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="SelectionFillInactive" Color="#1F2937"/>
    <SolidColorBrush x:Key="RowHover" Color="#1D2128"/>
    <SolidColorBrush x:Key="RowAlternate" Color="#1A1D24"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#3A4150"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#525B6D"/>
    <SolidColorBrush x:Key="ScrollTrack" Color="Transparent"/>

    <!-- Chart neutrals -->
    <SolidColorBrush x:Key="ChartGuide" Color="#262A33"/>
    <SolidColorBrush x:Key="ChartOther" Color="#64748B"/>

</ResourceDictionary>
