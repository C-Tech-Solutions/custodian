<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Surface" Color="#101611"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#18201A"/>
    <SolidColorBrush x:Key="SurfaceSubtle" Color="#202A22"/>
    <SolidColorBrush x:Key="SurfaceMuted" Color="#2A362B"/>
    <SolidColorBrush x:Key="HeaderSurface" Color="#121A14"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#18201A"/>
    <SolidColorBrush x:Key="OverlayScrim" Color="#A0000000"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="Border" Color="#2E3B30"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#455747"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2E3B30"/>
    <SolidColorBrush x:Key="Divider" Color="#263328"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#263328"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#E7F1E3"/>
    <SolidColorBrush x:Key="TextStrong" Color="#F5FBF2"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A9B99F"/>
    <SolidColorBrush x:Key="MutedStrong" Color="#C4D4BC"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#68745F"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="AccentHover" Color="#16A34A"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#166534"/>
    <SolidColorBrush x:Key="AccentSubtle" Color="#1D3B24"/>
    <SolidColorBrush x:Key="AccentRing" Color="#4ADE80"/>

    <!-- States -->
    <SolidColorBrush x:Key="HoverFill" Color="#243027"/>
    <SolidColorBrush x:Key="PressedFill" Color="#2E3C31"/>
    <SolidColorBrush x:Key="SelectionFill" Color="#14532D"/>
    <SolidColorBrush x:Key="SelectionFillInactive" Color="#26352B"/>
    <SolidColorBrush x:Key="RowHover" Color="#1D271F"/>
    <SolidColorBrush x:Key="RowAlternate" Color="#151D17"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#EAB308"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#455747"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#607761"/>
    <SolidColorBrush x:Key="ScrollTrack" Color="Transparent"/>

    <!-- Chart neutrals -->
    <SolidColorBrush x:Key="ChartGuide" Color="#2E3B30"/>
    <SolidColorBrush x:Key="ChartOther" Color="#71816E"/>

</ResourceDictionary>
