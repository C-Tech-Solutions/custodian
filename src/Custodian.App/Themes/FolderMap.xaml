<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Custodian.App.Controls"
                    xmlns:presentation="clr-namespace:Custodian.Core.Presentation;assembly=Custodian.Core">

    <!--
        Folder Map in the left panel. Rows stretch to the panel width and never scroll sideways:
        names trim with an ellipsis, size and share stay pinned to the right edge, and each level
        indents a little instead of a full expander column.
    -->

    <Style x:Key="FolderMapItem" TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
        <Setter Property="Padding" Value="4,3,8,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander"
                                              Style="{StaticResource TreeViewToggleStyle}"
                                              ClickMode="Press"
                                              VerticalAlignment="Top"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                  ContentSource="Header"
                                                  Margin="4,0,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="SelectionMark"
                                Width="3"
                                Margin="0,5"
                                CornerRadius="1.5"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"
                                Visibility="Collapsed"/>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="14,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}"/>
                        </Trigger>
                        <!--
                            Highlight the tree's selected item rather than this container's IsSelected:
                            a row scrolled far out of view comes back in a new, unselected container.
                        -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static controls:SameReferenceConverter.Instance}">
                                    <Binding/>
                                    <Binding Path="SelectedItem" RelativeSource="{RelativeSource AncestorType={x:Type TreeView}}"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionFill}"/>
                            <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A little air above each scan heading so separate scans read as separate groups. -->
            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                <Setter Property="Margin" Value="0,4,0,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Virtualized so expanding a folder with thousands of subfolders (WinSxS, node_modules) only
        builds the rows on screen: about 0.1 s instead of 6 s for 2,000 subfolders.
    -->
    <Style x:Key="FolderMapTree" TargetType="{x:Type TreeView}" BasedOn="{StaticResource {x:Type TreeView}}">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FolderMapItem}"/>
    </Style>

    <HierarchicalDataTemplate DataType="{x:Type presentation:FolderNode}" ItemsSource="{Binding Children}">
        <Grid ToolTip="{Binding FullPath}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Glyph"
                       Text="{Binding Icon}"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="14"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,0,7,0"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="NameText" Grid.Column="1"
                       Text="{Binding Name}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="SizeText" Grid.Column="2"
                       Text="{Binding Size}"
                       Foreground="{DynamicResource MutedStrong}"
                       FontSize="11.5"
                       Margin="8,0,0,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            <ProgressBar x:Name="ShareBar" Grid.Row="1" Grid.Column="1"
                         Height="4" MinHeight="0"
                         Maximum="100" Value="{Binding Percent}"
                         VerticalAlignment="Center"
                         Margin="0,3,0,1"/>
            <TextBlock x:Name="ShareText" Grid.Row="1" Grid.Column="2"
                       Text="{Binding PercentText}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="10.5"
                       Margin="8,1,0,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="LocationText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{Binding Location}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="10.5"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,1,0,0"
                       Visibility="Collapsed"/>
        </Grid>
        <HierarchicalDataTemplate.Triggers>
            <!-- A scan heading: icon and bold name, no share of a parent, and the path when the name hides it. -->
            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="NameText" Property="FontSize" Value="13"/>
                <Setter TargetName="SizeText" Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="SizeText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter TargetName="ShareText" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ShareBar" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="LocationText" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Location}" Value="">
                <Setter TargetName="LocationText" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
</ResourceDictionary>
