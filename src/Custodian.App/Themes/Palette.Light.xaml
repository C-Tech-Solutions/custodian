<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Surface" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSubtle" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="SurfaceMuted" Color="#EAEDF1"/>
    <SolidColorBrush x:Key="HeaderSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayScrim" Color="#80000000"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="Border" Color="#E2E5EB"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#CDD2DA"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#E2E5EB"/>
    <SolidColorBrush x:Key="Divider" Color="#EEF0F4"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#F1F3F6"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextStrong" Color="#0B1220"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="MutedStrong" Color="#475569"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentSubtle" Color="#EFF4FF"/>
    <SolidColorBrush x:Key="AccentRing" Color="#93C5FD"/>

    <!-- States -->
    <SolidColorBrush x:Key="HoverFill" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="PressedFill" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SelectionFill" Color="#DCE7FB"/>
    <SolidColorBrush x:Key="SelectionFillInactive" Color="#E5E9F1"/>
    <SolidColorBrush x:Key="RowHover" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="RowAlternate" Color="#FAFBFC"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#C5CBD4"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A8B0BB"/>
    <SolidColorBrush x:Key="ScrollTrack" Color="Transparent"/>

    <!-- Chart neutrals -->
    <SolidColorBrush x:Key="ChartGuide" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ChartOther" Color="#94A3B8"/>

</ResourceDictionary>
