<Window x:Class="Custodian.App.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custodian Updates"
        SizeToContent="WidthAndHeight"
        MinWidth="460"
        MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1"
            CornerRadius="{StaticResource PanelCorner}"
            Padding="0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderSurface}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="16,13">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IconButton}"
                            Click="Cancel_Click"
                            ToolTip="Close"
                            Margin="12,0,0,0">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <Path Data="{StaticResource IconCloseGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Style="{StaticResource VectorIconPath}"/>
                        </Viewbox>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="IconBadge"
                                Width="30"
                                Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource AccentSubtle}"
                                BorderBrush="{DynamicResource AccentRing}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path x:Name="IconPath"
                                      Data="{StaticResource IconInfoGeometry}"
                                      Stroke="{DynamicResource AccentBrush}"
                                      Style="{StaticResource VectorIconPath}"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Style="{StaticResource DisplayHeader}"
                                       FontSize="16"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SubtitleText"
                                       Text="Custodian updater"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceRaised}"
                    Padding="18,16,18,14">
                <TextBlock x:Name="MessageText"
                           Style="{StaticResource MutedText}"
                           FontSize="13"
                           LineHeight="19"
                           TextWrapping="Wrap"/>
            </Border>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceSubtle}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton"
                            Content="Not now"
                            MinWidth="92"
                            Click="Cancel_Click"/>
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource AccentButton}"
                            Content="OK"
                            MinWidth="104"
                            IsDefault="True"
                            Click="Primary_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
