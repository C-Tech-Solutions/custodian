<Window x:Class="Custodian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Custodian.App.Controls"
        xmlns:services="clr-namespace:Custodian.App.Services"
        xmlns:presentation="clr-namespace:Custodian.Core.Presentation;assembly=Custodian.Core"
        Title="Custodian Disk Analyzer"
        Icon="Assets/Custodian.ico"
        Height="880" Width="1400" MinHeight="720" MinWidth="1120"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type presentation:FolderNode}" ItemsSource="{Binding Children}">
            <Grid MinWidth="240" Margin="0,1" ToolTip="{Binding FullPath}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="8,0,0,0"/>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,3,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="3" Maximum="100" Value="{Binding Percent}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="8,0,0,0"/>
                </Grid>
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="SortableColumnHeaderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ColumnHeaderText}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Sort rows by this column"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- =============== TOP COMMAND BAR =============== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource HeaderSurface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Image Width="28" Height="28"
                           Source="Assets/CustodianIconHeader.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="Custodian"
                               FontFamily="{StaticResource UiFontDisplay}"
                               FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextStrong}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox x:Name="PathBox" IsEditable="True" Padding="34,7,10,7"
                              ToolTip="Folder or drive to scan (Ctrl+L)"/>
                    <Viewbox Width="14" Height="14"
                             VerticalAlignment="Center" Margin="11,0,0,0"
                             IsHitTestVisible="False">
                        <Path Data="{StaticResource IconFolderGeometry}"
                              Stroke="{DynamicResource MutedBrush}"
                              Style="{StaticResource VectorIconPath}"/>
                    </Viewbox>
                </Grid>

                <Button Grid.Column="2" Content="Browse" Click="Browse_Click" ToolTip="Browse for folder..."/>
                <Button x:Name="StartButton" Grid.Column="3" Content="Scan" Click="Start_Click"
                        Style="{StaticResource AccentButton}" ToolTip="Start scan"/>
                <Button x:Name="StopButton" Grid.Column="4" Content="Stop" Click="Stop_Click"
                        IsEnabled="False" ToolTip="Stop scan (Esc)"/>

                <ComboBox x:Name="ModeBox" Grid.Column="5" Width="118" Margin="6,0,3,0" SelectedIndex="0"
                          ToolTip="Scan engine">
                    <ComboBoxItem Content="Auto"/>
                    <ComboBoxItem Content="Recursive"/>
                    <ComboBoxItem Content="MFT"/>
                </ComboBox>

                <CheckBox x:Name="AllocatedSizeBox" Grid.Column="6" Content="Allocated"
                          VerticalAlignment="Center" Margin="10,0,6,0"
                          ToolTip="Include on-disk allocated size"/>

                <Menu Grid.Column="7" VerticalAlignment="Center" Margin="6,0,0,0">
                    <MenuItem Header="File" Padding="8,4">
                        <MenuItem Header="Open Scan...                Ctrl+O" Click="OpenScan_Click"/>
                        <MenuItem Header="Save Scan...                Ctrl+S" Click="SaveScan_Click"/>
                        <Separator/>
                        <MenuItem Header="Export CSV...               Ctrl+E" Click="ExportCsv_Click"/>
                        <MenuItem Header="Export JSON..." Click="ExportJson_Click"/>
                    </MenuItem>
                    <MenuItem Header="View" Padding="8,4">
                        <MenuItem Header="Recycle Bin" Click="ShowRecycleBin_Click"/>
                        <Separator/>
                        <MenuItem x:Name="AutoRelaunchAdminMenuItem"
                                  Header="Always open as administrator"
                                  IsCheckable="True"
                                  Click="AutoRelaunchAdmin_Click"/>
                        <Separator/>
                        <MenuItem Header="Toggle Theme                Ctrl+T" Click="ToggleTheme_Click"/>
                        <MenuItem Header="Keyboard Shortcuts          Ctrl+/" Click="ShowShortcuts_Click"/>
                    </MenuItem>
                    <MenuItem Header="Help">
                        <MenuItem x:Name="AutoUpdateOnStartupMenuItem"
                                  Header="Automatically download updates on startup"
                                  IsCheckable="True"
                                  Click="AutoUpdateOnStartup_Click"/>
                        <Separator/>
                        <MenuItem x:Name="CheckUpdatesMenuItem" Header="Check for Updates" Click="CheckUpdates_Click"/>
                    </MenuItem>
                </Menu>

                <Menu x:Name="ThemeSelectorMenu" Grid.Column="8" VerticalAlignment="Center" Margin="6,0,0,0">
                    <MenuItem Header="Theme" Padding="10,5" ToolTip="Select app color scheme">
                        <MenuItem x:Name="DarkThemeItem" Header="Dark"
                                  Tag="{x:Static services:AppTheme.Dark}"
                                  IsCheckable="True" Click="ThemeMenu_Click"/>
                        <MenuItem x:Name="LightThemeItem" Header="Light"
                                  Tag="{x:Static services:AppTheme.Light}"
                                  IsCheckable="True" Click="ThemeMenu_Click"/>
                        <Separator/>
                        <MenuItem x:Name="OceanThemeItem" Header="Ocean"
                                  Tag="{x:Static services:AppTheme.Ocean}"
                                  IsCheckable="True" Click="ThemeMenu_Click"/>
                        <MenuItem x:Name="ForestThemeItem" Header="Forest"
                                  Tag="{x:Static services:AppTheme.Forest}"
                                  IsCheckable="True" Click="ThemeMenu_Click"/>
                        <MenuItem x:Name="EmberThemeItem" Header="Ember"
                                  Tag="{x:Static services:AppTheme.Ember}"
                                  IsCheckable="True" Click="ThemeMenu_Click"/>
                    </MenuItem>
                </Menu>

                <Border Grid.Column="9" Style="{StaticResource StatusChip}"
                        Margin="8,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EngineBadgeDot" Width="6" Height="6"
                                 Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="EngineBadge" Text="Ready"
                                   Foreground="{DynamicResource MutedStrong}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =============== ELEVATION WARNING =============== -->
        <Border x:Name="ElevationWarningBanner"
                DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceSubtle}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="16" Height="16"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0">
                    <Path Data="{StaticResource IconWarningGeometry}"
                          Stroke="{DynamicResource WarningBrush}"
                          Style="{StaticResource VectorIconPath}"/>
                </Viewbox>
                <TextBlock Grid.Column="1"
                           Text="Custodian is not running as administrator. NTFS MFT scans may fall back or miss protected areas."
                           Foreground="{DynamicResource TextStrong}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Button x:Name="RelaunchAsAdminButton"
                        Grid.Column="2"
                        Content="Relaunch as administrator"
                        Margin="14,0,0,0"
                        Click="RelaunchAsAdmin_Click"
                        ToolTip="Restart Custodian elevated so MFT scans can access protected NTFS metadata"/>
            </Grid>
        </Border>

        <!-- =============== BOTTOM FOOTER =============== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceSubtle}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus" Text="Ready"
                           Foreground="{DynamicResource MutedStrong}"
                           FontWeight="SemiBold" FontSize="11.5"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" x:Name="FooterDetail"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="FooterRate"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11.5"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Grid.Column="3" x:Name="FooterEta"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11.5"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ProgressBar x:Name="ProgressBar" Grid.Column="4" Width="180" Height="6"
                             IsIndeterminate="False" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- =============== MAIN GRID =============== -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="320" MinWidth="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition x:Name="RightCol" Width="350" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="260" MinHeight="160"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,10,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="TARGETS" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ShowCloudTargetsBox"
                                      Content="Cloud"
                                      IsChecked="True"
                                      Margin="0,0,10,0"
                                      Checked="ShowCloudTargets_Changed"
                                      Unchecked="ShowCloudTargets_Changed"
                                      ToolTip="Show cloud provider targets"/>
                            <Button Style="{StaticResource ExplorerNavButton}"
                                    Content="Refresh"
                                    Click="RefreshTargets_Click"
                                    ToolTip="Refresh drives, cloud providers, and connected phones"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="DriveList" Grid.Row="1"
                             ItemsSource="{Binding TargetRows}"
                             SelectionChanged="DriveList_SelectionChanged"
                             Margin="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3" MinHeight="34">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                               FontSize="14"
                                               Foreground="{Binding IconBrush, Converter={x:Static controls:ColorStringToBrushConverter.Instance}}"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1"
                                                Padding="5,1"
                                                Margin="6,0,0,0"
                                                CornerRadius="4"
                                                BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1"
                                                Background="{DynamicResource SurfaceSubtle}"
                                                Visibility="{Binding ScanStatusVisibility}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ScanStatusIcon}"
                                                           FontFamily="{StaticResource IconFont}"
                                                           Foreground="{Binding ScanStatusBrush, Converter={x:Static controls:ColorStringToBrushConverter.Instance}}"
                                                           FontSize="10"
                                                           Margin="0,0,3,0"/>
                                                <TextBlock Text="{Binding ScanStatusText}"
                                                           Foreground="{Binding ScanStatusBrush, Converter={x:Static controls:ColorStringToBrushConverter.Instance}}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding UsedText}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                               Margin="8,0,0,0"/>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="4"
                                                 Maximum="100" Value="{Binding UsedPercent}"
                                                 Margin="0,4,0,0"
                                                 Visibility="{Binding UsageVisibility}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding DetailText}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding DetailVisibility}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Row="2"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  Style="{StaticResource HorizontalSectionSplitter}"
                                  ToolTip="Drag to resize Targets and Folder Map"/>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="FOLDER MAP" Margin="14,8,14,2"/>
                        <TextBlock Grid.Row="1" Text="Click any scanned folder to jump there."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="14,0,14,6"/>
                        <TreeView x:Name="FolderTree" Grid.Row="2"
                                  ItemsSource="{Binding FolderNodes}"
                                  SelectedItemChanged="FolderTree_SelectedItemChanged"
                                  Margin="8,0,8,10"/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <!-- CENTER PANEL -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <DockPanel x:Name="WorkspaceHost">

                        <!-- Folder header -->
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceSubtle}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="0,0,0,1"
                                Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BackButton" Style="{StaticResource ExplorerNavIconButton}"
                                            Click="Back_Click" IsEnabled="False"
                                            AutomationProperties.Name="Back"
                                            ToolTip="Go back to the previous folder (Alt+Left)">
                                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                                            <Path Data="{StaticResource IconChevronLeftGeometry}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Style="{StaticResource VectorIconPath}"/>
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="ForwardButton" Style="{StaticResource ExplorerNavIconButton}"
                                            Click="Forward_Click" IsEnabled="False"
                                            AutomationProperties.Name="Forward"
                                            ToolTip="Go forward to the next folder (Alt+Right)">
                                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                                            <Path Data="{StaticResource IconChevronRightGeometry}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Style="{StaticResource VectorIconPath}"/>
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="UpButton" Style="{StaticResource ExplorerNavIconButton}"
                                            Click="Up_Click" IsEnabled="False"
                                            AutomationProperties.Name="Up"
                                            ToolTip="Go to the parent folder (Alt+Up / Backspace)">
                                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                                            <Path Data="{StaticResource IconChevronUpGeometry}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Style="{StaticResource VectorIconPath}"/>
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="RefreshButton" Style="{StaticResource ExplorerNavIconButton}"
                                            Click="Refresh_Click"
                                            AutomationProperties.Name="Rescan"
                                            ToolTip="Scan the folder shown in the path box (F5)">
                                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                                            <Path Data="{StaticResource IconRefreshGeometry}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Style="{StaticResource VectorIconPath}"/>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCorner}"
                                        MinHeight="32"
                                        Margin="6,0,10,0">
                                    <ScrollViewer x:Name="BreadcrumbScrollViewer"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Margin="7,0">
                                        <ItemsControl ItemsSource="{Binding BreadcrumbItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource BreadcrumbButton}"
                                                                Content="{Binding Name}" Tag="{Binding}"
                                                                Click="Breadcrumb_Click"/>
                                                        <Viewbox Width="9" Height="9"
                                                                 VerticalAlignment="Center" Margin="2,0">
                                                            <Path Data="{StaticResource IconChevronRightGeometry}"
                                                                  Stroke="{DynamicResource DisabledTextBrush}"
                                                                  Style="{StaticResource VectorIconPath}"/>
                                                        </Viewbox>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <Grid Grid.Column="2">
                                    <ComboBox x:Name="JumpBox" IsEditable="True"
                                              IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                              Padding="30,7,10,7"
                                              KeyUp="JumpBox_KeyUp"
                                              SelectionChanged="JumpBox_SelectionChanged"
                                              ToolTip="Jump to folder (Ctrl+K)">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinWidth="220">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Size}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="11" Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                               Text="{Binding FullPath}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Viewbox Width="13" Height="13"
                                             VerticalAlignment="Center" Margin="10,0,0,0"
                                             IsHitTestVisible="False">
                                        <Path Data="{StaticResource IconSearchGeometry}"
                                              Stroke="{DynamicResource MutedBrush}"
                                              Style="{StaticResource VectorIconPath}"/>
                                    </Viewbox>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Results toolbar -->
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="0,0,0,1"
                                Padding="14,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="220"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SegmentedGroup}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ViewContents" Content="Contents" Tag="Contents"
                                                     GroupName="ViewMode" IsChecked="True" Click="ViewMode_Click"/>
                                        <RadioButton x:Name="ViewLargestFiles" Content="Files" Tag="LargestFiles"
                                                     GroupName="ViewMode" Click="ViewMode_Click"
                                                     ToolTip="Largest files"/>
                                        <RadioButton x:Name="ViewLargestFolders" Content="Folders" Tag="LargestFolders"
                                                     GroupName="ViewMode" Click="ViewMode_Click"
                                                     ToolTip="Largest folders"/>
                                        <RadioButton x:Name="ViewExtensions" Content="Extensions" Tag="Extensions"
                                                     GroupName="ViewMode" Click="ViewMode_Click"/>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Column="1" Margin="12,0,0,0">
                                    <TextBox x:Name="FilterBox" Padding="32,6,28,6"
                                             TextChanged="FilterBox_TextChanged"
                                             KeyDown="FilterBox_KeyDown"
                                             ToolTip="Filter rows by name or path (Ctrl+F)"/>
                                    <Viewbox Width="13" Height="13"
                                             VerticalAlignment="Center" Margin="11,0,0,0"
                                             IsHitTestVisible="False">
                                        <Path Data="{StaticResource IconSearchGeometry}"
                                              Stroke="{DynamicResource MutedBrush}"
                                              Style="{StaticResource VectorIconPath}"/>
                                    </Viewbox>
                                    <TextBlock x:Name="FilterPlaceholder" Text="Filter rows by name or path..."
                                               Foreground="{DynamicResource DisabledTextBrush}"
                                               VerticalAlignment="Center" Margin="36,0,0,0"
                                               IsHitTestVisible="False"/>
                                    <Button x:Name="FilterClearButton" Style="{StaticResource IconButton}"
                                            Width="24" Visibility="Collapsed"
                                            HorizontalAlignment="Right" Margin="0,0,2,0"
                                            Click="FilterClear_Click" ToolTip="Clear filter (Esc)">
                                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                                            <Path Data="{StaticResource IconCloseGeometry}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Style="{StaticResource VectorIconPath}"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>

                                <StackPanel Visibility="Collapsed">
                                    <TextBlock x:Name="SelectedTitleText"
                                               Text="No scan loaded"/>
                                    <TextBlock x:Name="SelectedSubText"
                                               Text="Choose a path and scan."/>
                                    <TextBlock x:Name="FilterCountText"
                                               Text=""/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Selection actions -->
                        <Border x:Name="SelectionActionsBar"
                                DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceSubtle}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="0,0,0,1"
                                Padding="14,6"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectionStatusText"
                                           Text="No selection"
                                           Foreground="{DynamicResource MutedStrong}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0"/>
                                <WrapPanel Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center">
                                    <Button x:Name="OpenSelectionButton"
                                            Style="{StaticResource ExplorerNavButton}"
                                            Content="Open"
                                            Click="OpenSelected_Click"
                                            ToolTip="Open the selected item"/>
                                    <Button x:Name="RevealSelectionButton"
                                            Style="{StaticResource ExplorerNavButton}"
                                            Content="Reveal"
                                            Click="RevealSelected_Click"
                                            ToolTip="Reveal the selected item in Explorer"/>
                                    <Button x:Name="CopyPathSelectionButton"
                                            Style="{StaticResource ExplorerNavButton}"
                                            Content="Copy Path"
                                            Click="CopyPath_Click"
                                            ToolTip="Copy selected paths"/>
                                    <Button x:Name="CopySelectionButton"
                                            Content="Copy"
                                            Click="CopySelection_Click"
                                            ToolTip="Copy selected files or folders"/>
                                    <Button x:Name="MoveSelectionButton"
                                            Content="Move"
                                            Click="MoveSelection_Click"
                                            ToolTip="Move selected files or folders"/>
                                    <Button x:Name="ExportSelectionButton"
                                            Style="{StaticResource ExplorerNavButton}"
                                            Content="Export CSV"
                                            Click="ExportSelectionCsv_Click"
                                            ToolTip="Export selected rows to CSV"/>
                                    <Button x:Name="DeleteSelectionButton"
                                            Content="Delete"
                                            Click="DeleteSelected_Click"
                                            ToolTip="Move selected files or folders to the Recycle Bin"/>
                                    <Button x:Name="PermanentDeleteSelectionButton"
                                            Content="Delete Permanently"
                                            Click="PermanentDeleteSelected_Click"
                                            ToolTip="Permanently delete selected files or folders without using the Recycle Bin"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Results list. A plain ListView with a flat
                             ItemTemplate and a static header row above it,
                             rather than a DataGrid. The per-view-switch stutter
                             came from BulkObservableCollection.ReplaceAll
                             emitting notifications for every realized row;
                             ReplaceAll now reconciles unchanged items and emits
                             granular Replace/Add/Remove only as needed. Header
                             and row column widths are fixed pixel values so
                             they stay aligned. -->
                        <DockPanel x:Name="ResultsHost">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        Background="{DynamicResource SurfaceSubtle}"
                                        Height="32">
                                <Border Width="36"/>
                                <Border Width="300" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="Name" MouseLeftButtonUp="DetailsColumnHeader_Click">
                                    <TextBlock x:Name="NameColumnHeader" Text="Name" Style="{StaticResource SortableColumnHeaderText}"/>
                                </Border>
                                <Border Width="64" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="Kind" MouseLeftButtonUp="DetailsColumnHeader_Click">
                                    <TextBlock x:Name="KindColumnHeader" Text="Type" Style="{StaticResource SortableColumnHeaderText}"/>
                                </Border>
                                <Border Width="92" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="LogicalSize" MouseLeftButtonUp="DetailsColumnHeader_Click">
                                    <TextBlock x:Name="LogicalSizeColumnHeader" Text="Size" Style="{StaticResource SortableColumnHeaderText}"/>
                                </Border>
                                <Border Width="130" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="Percent" MouseLeftButtonUp="DetailsColumnHeader_Click">
                                    <TextBlock x:Name="PercentColumnHeader" Text="Share" Style="{StaticResource SortableColumnHeaderText}"/>
                                </Border>
                                <Border Width="92" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="AllocatedSize" MouseLeftButtonUp="DetailsColumnHeader_Click">
                                    <TextBlock x:Name="AllocatedSizeColumnHeader" Text="Allocated" Style="{StaticResource SortableColumnHeaderText}"/>
                                </Border>
                                <Border Width="68" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="FileCount" MouseLeftButtonUp="DetailsColumnHeader_Click">
                                    <TextBlock x:Name="FileCountColumnHeader" Text="Files" Style="{StaticResource SortableColumnHeaderText}"/>
                                </Border>
                                <Border Width="72" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="DirectoryCount" MouseLeftButtonUp="DetailsColumnHeader_Click">
                                    <TextBlock x:Name="DirectoryCountColumnHeader" Text="Folders" Style="{StaticResource SortableColumnHeaderText}"/>
                                </Border>
                                <Border Width="320" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="FullPath" MouseLeftButtonUp="DetailsColumnHeader_Click">
                                    <TextBlock x:Name="FullPathColumnHeader" Text="Path" Style="{StaticResource SortableColumnHeaderText}"/>
                                </Border>
                            </StackPanel>
                            <ListView x:Name="DetailsGrid"
                                      ItemsSource="{Binding DetailRowsView}"
                                      SelectionMode="Extended"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      SelectionChanged="DetailsGrid_SelectionChanged"
                                      MouseDoubleClick="DetailsGrid_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="DetailsGrid_PreviewMouseRightButtonDown"
                                      PreviewKeyDown="DetailsGrid_PreviewKeyDown">
                                <ListView.ContextMenu>
                                    <ContextMenu Opened="DetailsContextMenu_Opened">
                                        <MenuItem x:Name="OpenSelectedMenuItem" Header="Open" Click="OpenSelected_Click"/>
                                        <MenuItem x:Name="RevealSelectedMenuItem" Header="Reveal in Explorer" Click="RevealSelected_Click"/>
                                        <MenuItem x:Name="CopyToFolderMenuItem" Header="Copy to Folder..." Click="CopySelection_Click"/>
                                        <MenuItem x:Name="MoveToFolderMenuItem" Header="Move to Folder..." Click="MoveSelection_Click"/>
                                        <MenuItem x:Name="CopyPortableToPcMenuItem" Header="Copy selected files to PC..." Click="CopyPortableToPc_Click"/>
                                        <Separator x:Name="CopyPortableToPcSeparator"/>
                                        <Separator/>
                                        <MenuItem x:Name="CopyPathMenuItem" Header="Copy Path" Click="CopyPath_Click"/>
                                        <MenuItem x:Name="CopyRowsMenuItem" Header="Copy Rows" Click="CopyRows_Click"/>
                                        <MenuItem x:Name="ExportSelectionMenuItem" Header="Export Selection CSV..." Click="ExportSelectionCsv_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="DeleteSelectedMenuItem" Header="Move to Recycle Bin" Click="DeleteSelected_Click"/>
                                        <MenuItem x:Name="PermanentDeleteSelectedMenuItem" Header="Delete Permanently" Click="PermanentDeleteSelected_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Height="30">
                                            <TextBlock Width="36" Text="{Binding Icon}"
                                                       FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding CategoryColor, Converter={x:Static controls:ColorStringToBrushConverter.Instance}}"/>
                                            <TextBlock Width="300" Margin="4,0" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Width="64" Margin="4,0" Text="{Binding Kind}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Width="92" Margin="4,0" Text="{Binding LogicalSize}"
                                                       VerticalAlignment="Center"/>
                                            <Grid Width="130" Margin="4,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="46"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ShareTrack" Height="6" CornerRadius="3"
                                                        Background="{DynamicResource SurfaceSubtle}"
                                                        VerticalAlignment="Center">
                                                    <Border HorizontalAlignment="Left" CornerRadius="3"
                                                            Background="{Binding CategoryColor, Converter={x:Static controls:ColorStringToBrushConverter.Instance}}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{x:Static controls:PercentToWidthConverter.Instance}">
                                                                <Binding Path="Percent"/>
                                                                <Binding Path="ActualWidth" ElementName="ShareTrack"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="11.5"/>
                                            </Grid>
                                            <TextBlock Width="92" Margin="4,0" Text="{Binding AllocatedSize}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Width="68" Margin="4,0" Text="{Binding FileCount}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Width="72" Margin="4,0" Text="{Binding DirectoryCount}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Width="320" Margin="4,0" Text="{Binding FullPath}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </DockPanel>

                    <!-- Recycle Bin workspace -->
                    <Grid x:Name="RecycleBinHost" Background="{DynamicResource SurfaceRaised}" Visibility="Collapsed">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource SurfaceSubtle}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="34" Height="34" CornerRadius="8"
                                                Background="{DynamicResource AccentSubtle}"
                                                BorderBrush="{DynamicResource AccentRing}"
                                                BorderThickness="1">
                                            <Viewbox Width="16" Height="16"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconRecycleBinGeometry}"
                                                      Stroke="{DynamicResource AccentBrush}"
                                                      Style="{StaticResource VectorIconPath}"/>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Recycle Bin" Style="{StaticResource DisplayHeader}"/>
                                            <TextBlock x:Name="RecycleBinStatusText"
                                                       Text="Review deleted items managed by Windows."
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="46,10,0,0">
                                        <Button Content="Back to Scan" Click="BackToScan_Click" ToolTip="Return to the scan workspace"/>
                                        <Button x:Name="RecycleBinRefreshButton" Content="Refresh" Click="RefreshRecycleBin_Click" ToolTip="Refresh Recycle Bin items"/>
                                        <Button Content="Open in Explorer" Click="OpenRecycleBinExplorer_Click" ToolTip="Open the Windows Recycle Bin"/>
                                        <Button x:Name="RecycleBinRestoreButton" Content="Restore" Click="RestoreRecycleBinSelected_Click" ToolTip="Restore selected items"/>
                                        <Button x:Name="RecycleBinDeleteButton" Content="Delete Permanently" Click="DeleteRecycleBinSelected_Click" ToolTip="Permanently delete selected items"/>
                                        <Button x:Name="RecycleBinEmptyButton" Content="Empty" Click="EmptyRecycleBin_Click" ToolTip="Permanently delete all Recycle Bin items"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource SurfaceRaised}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="RecycleBinFilterBox"
                                                 Padding="32,6,28,6"
                                                 TextChanged="RecycleBinFilterBox_TextChanged"
                                                 KeyDown="RecycleBinFilterBox_KeyDown"
                                                 ToolTip="Filter Recycle Bin items"/>
                                        <Viewbox Width="13" Height="13"
                                                 VerticalAlignment="Center"
                                                 Margin="11,0,0,0"
                                                 IsHitTestVisible="False">
                                            <Path Data="{StaticResource IconSearchGeometry}"
                                                  Stroke="{DynamicResource MutedBrush}"
                                                  Style="{StaticResource VectorIconPath}"/>
                                        </Viewbox>
                                        <TextBlock x:Name="RecycleBinFilterPlaceholder"
                                                   Text="Filter by name, original location, type, or recycle path..."
                                                   Foreground="{DynamicResource DisabledTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="36,0,0,0"
                                                   IsHitTestVisible="False"/>
                                        <Button x:Name="RecycleBinFilterClearButton"
                                                Style="{StaticResource IconButton}"
                                                Width="24"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,2,0"
                                                Click="RecycleBinFilterClear_Click"
                                                ToolTip="Clear filter">
                                            <Viewbox Width="12" Height="12" Stretch="Uniform">
                                                <Path Data="{StaticResource IconCloseGeometry}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Style="{StaticResource VectorIconPath}"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               x:Name="RecycleBinFilterCountText"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>
                            </Border>

                            <Grid Background="{DynamicResource SurfaceRaised}">
                                <DockPanel x:Name="RecycleBinResultsHost"
                                           Background="{DynamicResource SurfaceRaised}">
                                    <StackPanel DockPanel.Dock="Top"
                                                Orientation="Horizontal"
                                                Background="{DynamicResource SurfaceSubtle}"
                                                Height="32">
                                        <Border Width="36"/>
                                        <Border Width="260" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="Name" MouseLeftButtonUp="RecycleBinColumnHeader_Click">
                                            <TextBlock x:Name="RecycleBinNameHeader" Text="Name" Style="{StaticResource SortableColumnHeaderText}"/>
                                        </Border>
                                        <Border Width="300" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="OriginalLocation" MouseLeftButtonUp="RecycleBinColumnHeader_Click">
                                            <TextBlock x:Name="RecycleBinOriginalLocationHeader" Text="Original Location" Style="{StaticResource SortableColumnHeaderText}"/>
                                        </Border>
                                        <Border Width="150" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="DateDeleted" MouseLeftButtonUp="RecycleBinColumnHeader_Click">
                                            <TextBlock x:Name="RecycleBinDateDeletedHeader" Text="Date Deleted" Style="{StaticResource SortableColumnHeaderText}"/>
                                        </Border>
                                        <Border Width="92" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="Size" MouseLeftButtonUp="RecycleBinColumnHeader_Click">
                                            <TextBlock x:Name="RecycleBinSizeHeader" Text="Size" Style="{StaticResource SortableColumnHeaderText}"/>
                                        </Border>
                                        <Border Width="160" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="ItemType" MouseLeftButtonUp="RecycleBinColumnHeader_Click">
                                            <TextBlock x:Name="RecycleBinTypeHeader" Text="Type" Style="{StaticResource SortableColumnHeaderText}"/>
                                        </Border>
                                        <Border Width="340" Margin="4,0" Background="Transparent" Cursor="Hand" Tag="RecyclePath" MouseLeftButtonUp="RecycleBinColumnHeader_Click">
                                            <TextBlock x:Name="RecycleBinPathHeader" Text="Recycle Path" Style="{StaticResource SortableColumnHeaderText}"/>
                                        </Border>
                                    </StackPanel>

                                    <ListView x:Name="RecycleBinGrid"
                                              Background="{DynamicResource SurfaceRaised}"
                                              ItemsSource="{Binding RecycleBinRowsView}"
                                              SelectionMode="Extended"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              SelectionChanged="RecycleBinGrid_SelectionChanged"
                                              MouseDoubleClick="RecycleBinGrid_MouseDoubleClick"
                                              PreviewKeyDown="RecycleBinGrid_PreviewKeyDown">
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Restore" Click="RestoreRecycleBinSelected_Click"/>
                                                <MenuItem Header="Delete Permanently" Click="DeleteRecycleBinSelected_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Open Recycle Bin in Explorer" Click="OpenRecycleBinExplorer_Click"/>
                                                <MenuItem Header="Copy Original Path" Click="CopyRecycleBinOriginalPath_Click"/>
                                                <MenuItem Header="Copy Recycle Path" Click="CopyRecycleBinRecyclePath_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Refresh" Click="RefreshRecycleBin_Click"/>
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Height="30">
                                                    <TextBlock Width="36"
                                                               Text="{Binding Icon}"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding CategoryColor, Converter={x:Static controls:ColorStringToBrushConverter.Instance}}"/>
                                                    <TextBlock Width="260" Margin="4,0" Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Width="300" Margin="4,0" Text="{Binding OriginalLocation}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Width="150" Margin="4,0" Text="{Binding DateDeleted}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Width="92" Margin="4,0" Text="{Binding Size}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Width="160" Margin="4,0" Text="{Binding ItemType}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Width="340" Margin="4,0" Text="{Binding RecyclePath}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </DockPanel>

                                <Border x:Name="RecycleBinLoadingOverlay"
                                        Background="{DynamicResource SurfaceRaised}"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                MaxWidth="360">
                                        <Border Width="48" Height="48" CornerRadius="12"
                                                Background="{DynamicResource AccentSubtle}"
                                                HorizontalAlignment="Center">
                                            <Viewbox Width="24" Height="24"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconRecycleBinGeometry}"
                                                      Stroke="{DynamicResource AccentBrush}"
                                                      Style="{StaticResource VectorIconPath}"/>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock x:Name="RecycleBinLoadingText"
                                                   Text="Loading Recycle Bin items..."
                                                   Style="{StaticResource DisplayHeader}"
                                                   FontSize="15"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="0,14,0,4"/>
                                        <TextBlock Text="Reading the Windows Recycle Bin."
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>

                    <!-- Empty state -->
                    <Grid x:Name="EmptyStateHost" Background="{DynamicResource SurfaceRaised}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                            <Border Width="64" Height="64" CornerRadius="14"
                                    Background="{DynamicResource AccentSubtle}"
                                    HorizontalAlignment="Center">
                                <Viewbox Width="32" Height="32"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFolderGeometry}"
                                          Stroke="{DynamicResource AccentBrush}"
                                          Style="{StaticResource VectorIconPath}"/>
                                </Viewbox>
                            </Border>
                            <TextBlock x:Name="EmptyStateTitleText"
                                       Text="Scan a folder to get started"
                                       Style="{StaticResource DisplayHeader}"
                                       HorizontalAlignment="Center" Margin="0,20,0,4"/>
                            <TextBlock x:Name="EmptyStateDetailText"
                                       Text="Pick a drive or folder, then press Scan. You can also drag a folder onto this window."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="20,0,20,18"/>
                            <ItemsControl x:Name="EmptyStateDrives" Margin="0,0,0,18">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="EmptyStateDrive_Click"
                                                Margin="4" Padding="14,8"
                                                MinWidth="132" MaxWidth="220">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="14"
                                                           Foreground="{Binding IconBrush, Converter={x:Static controls:ColorStringToBrushConverter.Instance}}"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding UsedText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="EmptyStateStartButton"
                                        Click="Start_Click"
                                        Style="{StaticResource AccentButton}"
                                        Margin="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconPlayGeometry}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Style="{StaticResource VectorIconPath}"/>
                                        </Viewbox>
                                        <TextBlock Text="Start Scan"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OpenScan_Click" Margin="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconOpenFolderGeometry}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Style="{StaticResource VectorIconPath}"/>
                                        </Viewbox>
                                        <TextBlock Text="Open saved scan"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="ShowShortcuts_Click" Margin="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconKeyboardGeometry}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Style="{StaticResource VectorIconPath}"/>
                                        </Viewbox>
                                        <TextBlock Text="Keyboard shortcuts"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Loading skeleton -->
                    <Grid x:Name="LoadingHost" Background="{DynamicResource SurfaceRaised}" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Top" Margin="14,14">
                            <TextBlock Text="Scanning..." Style="{StaticResource DisplayHeader}"/>
                            <TextBlock x:Name="LoadingPathText" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11.5" Margin="0,4,0,16"
                                       TextTrimming="CharacterEllipsis"/>
                            <ItemsControl x:Name="SkeletonRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="28" Margin="0,2"
                                                CornerRadius="4"
                                                Background="{DynamicResource SurfaceSubtle}"
                                                Opacity="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <!-- Shortcut overlay -->
                    <Grid x:Name="ShortcutOverlay" Background="{DynamicResource OverlayScrim}"
                          Visibility="Collapsed" MouseDown="ShortcutOverlay_MouseDown">
                        <Border Style="{StaticResource Panel}" MaxWidth="520"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="20" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource DisplayHeader}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Text="Ctrl+O" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Open saved scan" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="1" Text="Ctrl+S" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Save current scan" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="2" Text="Ctrl+E" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Export CSV" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="3" Text="Ctrl+L" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Focus path box" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="4" Text="Ctrl+F" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Filter rows" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="5" Text="Ctrl+K" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Jump to folder" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="6" Text="Ctrl+T" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Toggle theme" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="7" Text="F5" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Re-scan current path" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="8" Text="Esc" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Stop scan / clear filter / close dialog" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="9" Text="Alt+Left / Right" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="Back / forward" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="10" Text="Alt+Up / Backspace" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="Up one folder" Foreground="{DynamicResource MutedStrong}"/>
                                    <TextBlock Grid.Row="11" Text="Enter" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="11" Grid.Column="1" Text="Open / drill into selected row" Foreground="{DynamicResource MutedStrong}"/>
                                </Grid>
                                <Button HorizontalAlignment="Right" Margin="0,16,0,0"
                                        Style="{StaticResource AccentButton}"
                                        Content="Got it" Click="ShortcutClose_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Toast container -->
                    <StackPanel x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Margin="14" IsHitTestVisible="True"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>

            <!-- RIGHT PANEL -->
            <Border x:Name="RightPanel" Grid.Column="4" Style="{StaticResource Panel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="SUMMARY" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SidebarToggleButton}"
                                Content=">>"
                                Click="CollapseRight_Click" ToolTip="Collapse panel"/>
                    </Grid>

                    <!-- Everything below the header scrolls as one unit so the chart and
                         summary tiles are never clipped when the window is short. The inner
                         DockPanel tracks the viewport height so the chart still fills the
                         panel when the window is tall, but scrolls once content overflows. -->
                    <ScrollViewer x:Name="SummaryScrollViewer"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DockPanel MinHeight="{Binding ViewportHeight, ElementName=SummaryScrollViewer}">
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SummaryMetrics}" Margin="11,4,11,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TileLabel}" Text="{Binding Label}"/>
                                        <TextBlock Style="{StaticResource TileValue}" Text="{Binding Value}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Style="{StaticResource TileDetail}" Text="{Binding Detail}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource Divider}"
                            BorderThickness="0,1,0,0"
                            Margin="14,4,14,0" Padding="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ChartTitleText" Text="Disk distribution"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextStrong}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource SegmentedGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TreemapChartModeButton" Content="Treemap" Tag="Treemap"
                                                 GroupName="ChartMode" IsChecked="True" Click="ChartMode_Click"/>
                                    <RadioButton x:Name="PieChartModeButton" Content="Pie" Tag="Pie"
                                                 GroupName="ChartMode" Click="ChartMode_Click"/>
                                    <RadioButton x:Name="BarsChartModeButton" Content="Bars" Tag="Bars"
                                                 GroupName="ChartMode" Click="ChartMode_Click"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ChartTotalText" Grid.Row="1" Grid.ColumnSpan="2"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       Margin="0,4,0,8" Text="Run a scan to render chart data."
                                       TextTrimming="CharacterEllipsis"/>
                            <ComboBox x:Name="ChartScopeBox" Grid.Row="2" Grid.ColumnSpan="2"
                                      SelectionChanged="ChartScope_SelectionChanged">
                                <ComboBoxItem Content="Selected folder" Tag="SelectedFolder"/>
                                <ComboBoxItem Content="Largest folders" Tag="LargestFolders"/>
                                <ComboBoxItem Content="Largest files" Tag="LargestFiles"/>
                                <ComboBoxItem Content="Extensions" Tag="Extensions"/>
                            </ComboBox>
                            <Grid x:Name="PieZoomControls" Grid.Row="3" Grid.ColumnSpan="2"
                                  Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Zoom"
                                           Foreground="{DynamicResource MutedStrong}"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="PieZoomSlider" Grid.Column="1"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0.75" Maximum="2.0" Value="1"
                                        TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        VerticalAlignment="Center"
                                        ToolTip="Pie chart zoom"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ElementName=PieZoomSlider, Path=Value, StringFormat={}{0:P0}}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" MinWidth="34"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                        Width="28" MinHeight="26"
                                        Click="ResetPieZoom_Click"
                                        ToolTip="Reset pie zoom">
                                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                                        <Path Data="{StaticResource IconResetGeometry}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Style="{StaticResource VectorIconPath}"/>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ChartSelectionText" DockPanel.Dock="Bottom"
                               Text="Select a slice to locate it in the grid."
                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               Margin="14,8,14,12" TextWrapping="Wrap"/>

                    <Grid MinHeight="280" Margin="11,10,11,0">
                        <Grid x:Name="TreemapHost">
                            <controls:TreemapControl x:Name="Treemap"
                                                     Slices="{Binding ChartSlices}"
                                                     SliceSelected="Chart_SliceSelected"
                                                     SliceDoubleClicked="Chart_SliceDoubleClicked"/>
                        </Grid>
                        <Grid x:Name="PieHost" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="230"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <controls:PieChartControl x:Name="PieChart"
                                                      Slices="{Binding ChartSlices}"
                                                      ZoomFactor="{Binding ElementName=PieZoomSlider, Path=Value}"
                                                      ClipToBounds="True"
                                                      SliceSelected="Chart_SliceSelected"
                                                      SliceDoubleClicked="Chart_SliceDoubleClicked"/>
                            <ItemsControl Grid.Row="1" Margin="0,6,0,0" ItemsSource="{Binding ChartSlices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4" Margin="0,1"
                                                    BorderBrush="{DynamicResource Divider}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="10" Height="10" CornerRadius="2"
                                                            Background="{Binding Color, Converter={x:Static controls:ColorStringToBrushConverter.Instance}}"
                                                            VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                                   FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding FormattedSize}" FontSize="11.5"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding PercentText}"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   FontSize="10.5" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </Grid>

                        <Grid x:Name="BarHost" Visibility="Collapsed">
                            <ListBox x:Name="ChartBars" ItemsSource="{Binding ChartSlices}"
                                     SelectionMode="Extended"
                                     SelectionChanged="ChartBars_SelectionChanged"
                                     MouseDoubleClick="ChartBars_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6" Margin="0,1"
                                                BorderBrush="{DynamicResource Divider}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="10" Height="20" CornerRadius="3"
                                                        Background="{Binding Color, Converter={x:Static controls:ColorStringToBrushConverter.Instance}}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                           FontWeight="SemiBold" Margin="10,0,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
                                                <ProgressBar Grid.Row="1" Grid.Column="1" Height="6"
                                                             Maximum="100" Value="{Binding Percent}"
                                                             Foreground="{Binding Color, Converter={x:Static controls:ColorStringToBrushConverter.Instance}}"
                                                             Margin="10,5,0,2"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PercentText}"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                    </DockPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="RightPanelTab" Grid.Column="4"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="8" Width="36"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed">
                <Button Style="{StaticResource SidebarRevealButton}" Content="&lt;&lt;"
                        Click="ExpandRight_Click" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,8,0,0"
                        ToolTip="Show summary panel"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
