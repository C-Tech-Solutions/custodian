<Window x:Class="Custodian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Custodian.App.Controls"
        xmlns:presentation="clr-namespace:Custodian.Core.Presentation;assembly=Custodian.Core"
        Title="Custodian Disk Analyzer" Height="860" Width="1360" MinHeight="720" MinWidth="1120"
        Background="#eef2f6">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#ffffff"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#cfd8e3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563eb"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748b"/>
        <SolidColorBrush x:Key="TextBrush" Color="#0f172a"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="AlternatingRowBackground" Value="#f8fafc"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type presentation:FolderNode}" ItemsSource="{Binding Children}">
            <Grid MinWidth="250" Margin="0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="3" Maximum="100" Value="{Binding Percent}" Foreground="{StaticResource AccentBrush}" Background="#e2e8f0" BorderThickness="0" Margin="0,3,0,0"/>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#162033" Padding="10" BorderBrush="#0f172a" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Custodian" Foreground="White" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="2,0,14,0"/>
                <ComboBox x:Name="PathBox" Grid.Column="1" IsEditable="True" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Browse" Click="Browse_Click"/>
                <Button x:Name="StartButton" Grid.Column="3" Content="Scan" Click="Start_Click"/>
                <Button x:Name="StopButton" Grid.Column="4" Content="Stop" Click="Stop_Click" IsEnabled="False"/>
                <ComboBox x:Name="ModeBox" Grid.Column="5" Width="118" Margin="4,0" SelectedIndex="0">
                    <ComboBoxItem Content="Auto"/>
                    <ComboBoxItem Content="Recursive"/>
                    <ComboBoxItem Content="MFT"/>
                </ComboBox>
                <CheckBox x:Name="AllocatedSizeBox" Grid.Column="6" Content="Allocated" Foreground="White" VerticalAlignment="Center" Margin="8,0"/>
                <Menu Grid.Column="7" VerticalAlignment="Center" Background="Transparent" Foreground="White" BorderThickness="0">
                    <MenuItem Header="File">
                        <MenuItem Header="Open Scan" Click="OpenScan_Click"/>
                        <MenuItem Header="Save Scan" Click="SaveScan_Click"/>
                        <Separator/>
                        <MenuItem Header="Export CSV" Click="ExportCsv_Click"/>
                        <MenuItem Header="Export JSON" Click="ExportJson_Click"/>
                    </MenuItem>
                </Menu>
                <Border Grid.Column="8" BorderBrush="#334155" BorderThickness="1" Background="#0f172a" Padding="8,4" Margin="6,0,0,0">
                    <TextBlock x:Name="EngineBadge" Text="Ready" Foreground="#bfdbfe" FontSize="12" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#f8fafc" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="Ready" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="ProgressBar" Grid.Column="1" Width="180" Height="14" IsIndeterminate="False" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Targets" FontWeight="SemiBold" FontSize="14" Margin="10,8"/>
                    <ListBox x:Name="DriveList" Grid.Row="1" ItemsSource="{Binding DriveRows}" SelectionChanged="DriveList_SelectionChanged" BorderThickness="0" Margin="6,0,6,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UsedText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="5" Maximum="100" Value="{Binding UsedPercent}" Foreground="{StaticResource AccentBrush}" Background="#e2e8f0" BorderThickness="0" Margin="0,4,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="Folders" FontWeight="SemiBold" FontSize="14" Margin="10,6"/>
                    <TreeView x:Name="FolderTree" Grid.Row="3" ItemsSource="{Binding FolderNodes}" SelectedItemChanged="FolderTree_SelectedItemChanged" BorderThickness="0" Margin="6,0,6,6"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="#dbe3ec"/>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#f8fafc" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BackButton" Click="Back_Click" ToolTip="Back" IsEnabled="False" Width="30" Padding="0">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="ForwardButton" Click="Forward_Click" ToolTip="Forward" IsEnabled="False" Width="30" Padding="0">
                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="UpButton" Click="Up_Click" ToolTip="Up one level" IsEnabled="False" Width="30" Padding="0">
                                        <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="8,0">
                                    <ItemsControl ItemsSource="{Binding BreadcrumbItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding Name}" Tag="{Binding}" Click="Breadcrumb_Click" Padding="6,2" MinHeight="24" Margin="0"/>
                                                    <TextBlock Text=">" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="5,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <ComboBox x:Name="JumpBox" Grid.Column="2" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" KeyUp="JumpBox_KeyUp" SelectionChanged="JumpBox_SelectionChanged" ToolTip="Jump to folder">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinWidth="230">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding FullPath}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <TextBlock Grid.Row="1" x:Name="SelectedTitleText" Text="No scan loaded" FontWeight="SemiBold" FontSize="18" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Contents" Tag="Contents" Click="ViewMode_Click"/>
                                <Button Content="Largest Files" Tag="LargestFiles" Click="ViewMode_Click"/>
                                <Button Content="Largest Folders" Tag="LargestFolders" Click="ViewMode_Click"/>
                                <Button Content="Extensions" Tag="Extensions" Click="ViewMode_Click"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="SelectedSubText" Text="Choose a path and scan." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="DetailsGrid" ItemsSource="{Binding DetailRows}" MouseDoubleClick="DetailsGrid_MouseDoubleClick" PreviewMouseRightButtonDown="DetailsGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="OpenSelected_Click"/>
                                <MenuItem Header="Reveal in Explorer" Click="RevealSelected_Click"/>
                                <Separator/>
                                <MenuItem Header="Copy Path" Click="CopyPath_Click"/>
                                <MenuItem Header="Copy Rows" Click="CopyRows_Click"/>
                                <MenuItem Header="Export Selection CSV" Click="ExportSelectionCsv_Click"/>
                                <Separator/>
                                <MenuItem Header="Move to Recycle Bin" Click="DeleteSelected_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.4*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding LogicalSize}" Width="110"/>
                            <DataGridTemplateColumn Header="Share" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Height="8" Maximum="100" Value="{Binding Percent}" Foreground="{StaticResource AccentBrush}" Background="#e2e8f0" BorderThickness="0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PercentText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedSize}" Width="110"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="86"/>
                            <DataGridTextColumn Header="Folders" Binding="{Binding DirectoryCount}" Width="86"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="#dbe3ec"/>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Summary" FontWeight="SemiBold" FontSize="14" Margin="10,8"/>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SummaryMetrics}" Margin="8,0,8,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#e2e8f0" BorderThickness="1" Padding="8" Margin="3" Background="#f8fafc">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Margin="8,2,8,0" Padding="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ChartTitleText" Text="Disk Distribution" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="PieChartModeButton" Content="Pie" GroupName="ChartMode" Tag="Pie" IsChecked="True" Click="ChartMode_Click" Margin="0,0,8,0"/>
                                <RadioButton Content="Bars" GroupName="ChartMode" Tag="Bars" Click="ChartMode_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ChartTotalText" Grid.Row="1" Grid.ColumnSpan="2" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,6" Text="Run a scan to render chart data." TextTrimming="CharacterEllipsis"/>
                            <ComboBox x:Name="ChartScopeBox" Grid.Row="2" Grid.ColumnSpan="2" SelectionChanged="ChartScope_SelectionChanged">
                                <ComboBoxItem Content="Selected Folder" Tag="SelectedFolder"/>
                                <ComboBoxItem Content="Largest Folders" Tag="LargestFolders"/>
                                <ComboBoxItem Content="Largest Files" Tag="LargestFiles"/>
                                <ComboBoxItem Content="Extensions" Tag="Extensions"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ChartSelectionText" DockPanel.Dock="Bottom" Text="Select a chart slice to locate it in the grid." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,6" TextWrapping="Wrap"/>

                    <Grid Margin="8,8,8,0">
                        <Grid x:Name="PieHost" MinHeight="240">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="230"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <controls:PieChartControl x:Name="PieChart" Slices="{Binding ChartSlices}" SliceSelected="PieChart_SliceSelected" SliceDoubleClicked="PieChart_SliceDoubleClicked"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="190" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding ChartSlices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4" Margin="0,1" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="9" Height="9" Background="{Binding Color}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding FormattedSize}" FontSize="11" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="BarHost" Visibility="Collapsed">
                            <ListBox x:Name="ChartBars" ItemsSource="{Binding ChartSlices}" SelectionChanged="ChartBars_SelectionChanged" MouseDoubleClick="ChartBars_MouseDoubleClick" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="5" Margin="0,1" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="8" Height="18" Background="{Binding Color}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                                                <ProgressBar Grid.Row="1" Grid.Column="1" Height="7" Maximum="100" Value="{Binding Percent}" Foreground="{Binding Color}" Background="#e2e8f0" BorderThickness="0" Margin="8,5,0,0"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PercentText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
